# bughunter-lite example config — copy to config.env (or export) and edit.
# config.env is gitignored; never commit real keys.

# --- LLM backend (the single seam in engine/agent.py) --------------------
# Which backend run_agent() uses: "claude" (Claude CLI) or "openai".
BH_BACKEND=claude

# Optional model override passed to the backend.
# For claude, e.g. a model alias; for openai, a model name.
BH_MODEL=

# --- OpenAI-compatible backend (only when BH_BACKEND=openai) --------------
# Works with any OpenAI-compatible endpoint (OpenAI, local gateways, etc.).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...your-key...
# OPENAI_MODEL=gpt-4o-mini   # used if BH_MODEL is unset

# --- Proxy / Burp ---------------------------------------------------------
# Route traffic through an intercepting proxy (e.g. Burp at 127.0.0.1:8080).
# transport.ScopedSession honors this but always bypasses localhost/NO_PROXY.
# BH_PROXY=http://127.0.0.1:8080
# Allow a self-signed proxy CA (skip TLS verify) ONLY when proxying:
# BH_PROXY_INSECURE=1
# --- Rate limit (compliance) ---------------------------------------------
# Cap requests per MINUTE across the whole session. Program limit = 100/min;
# set 80 to stay safely under. 0/unset = no throttle.
BH_RATE_MIN=80

# Burp MCP: if engine/burp-mcp.json exists, agent.py passes it to the Claude
# CLI (--mcp-config ... --strict-mcp-config), exposing the mcp__burp__* request
# tools. That file is gitignored — create it from your Burp MCP setup.
